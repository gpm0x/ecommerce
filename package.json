{
  "name": "verso-angular",
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n api,app -c blue,green \"npm:api\" \"npm:start\"",
    "start": "ng serve",
    "api": "node api/server.js",
    "api:reset": "node -e \"require('fs').copyFileSync('api/db.seed.json','api/db.json')\"",
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^10.0.7",
    "json-server": "^0.17.4",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
